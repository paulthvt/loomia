# Fastlane for iOS releases (#397). Kept small on purpose: Flutter builds the
# IPA in the workflow, fastlane only signs and uploads. Lanes run from ios/:
#
#   bundle exec fastlane signing      # CI only: keychain, cert, profile
#   flutter build ipa ... --export-options-plist=build/ios/ExportOptions.plist
#   bundle exec fastlane upload ipa:<path> changelog:<text>
#   bundle exec fastlane apple_auth_secret key:<path.p8> key_id:<id>   # by hand, every 6 months
#   bundle exec fastlane upload_listing screenshots:<dir> [dry_run:true]  # Store listing workflow
#
# Signing comes from secrets, not match or automatic signing: one team, one
# app, one CI (docs/architecture.md → Releases). Local builds keep Xcode's
# automatic signing; only the CI checkout is switched to manual.
# Setup and the yearly renewal: README.md → Releases → iOS.

default_platform(:ios)

platform :ios do
  desc 'App Store Connect API key from ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64).'
  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8'),
      is_key_content_base64: true
    )
  end

  desc 'CI: import the distribution certificate and profile, switch Release to manual signing.'
  lane :signing do
    UI.user_error!('signing is for CI: it switches the project to manual signing') unless is_ci

    # A temporary keychain, made default for this run and deleted with the runner.
    setup_ci

    require 'base64'
    tmp = File.expand_path('../build/signing', __dir__)
    FileUtils.mkdir_p(tmp)
    cert = File.join(tmp, 'distribution.p12')
    profile = File.join(tmp, 'appstore.mobileprovision')
    File.binwrite(cert, Base64.decode64(ENV.fetch('IOS_DISTRIBUTION_P12')))
    File.binwrite(profile, Base64.decode64(ENV.fetch('IOS_APPSTORE_PROFILE')))

    import_certificate(
      certificate_path: cert,
      certificate_password: ENV.fetch('IOS_DISTRIBUTION_P12_PASSWORD'),
      keychain_name: ENV.fetch('MATCH_KEYCHAIN_NAME'), # set by setup_ci
      keychain_password: ENV.fetch('MATCH_KEYCHAIN_PASSWORD')
    )
    install_provisioning_profile(path: profile)
    name = FastlaneCore::ProvisioningProfile.name(profile)
    team = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)

    update_code_signing_settings(
      path: 'Runner.xcodeproj',
      targets: ['Runner'],
      build_configurations: ['Release'],
      use_automatic_signing: false,
      team_id: team,
      code_sign_identity: 'Apple Distribution',
      profile_name: name
    )

    # flutter build ipa exports with this: the profile it just installed.
    export_options = File.expand_path('../../build/ios/ExportOptions.plist', __dir__)
    FileUtils.mkdir_p(File.dirname(export_options))
    File.write(export_options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>#{team}</string>
        <key>signingStyle</key><string>manual</string>
        <key>provisioningProfiles</key>
        <dict><key>app.loomia</key><string>#{name}</string></dict>
        <key>uploadSymbols</key><true/>
      </dict>
      </plist>
    PLIST
    UI.success("Signing with '#{name}'")
  end

  desc 'Upload an IPA to TestFlight, internal testers. Options: ipa (required), changelog.'
  lane :upload do |options|
    ipa = options[:ipa].to_s
    UI.user_error!("IPA not found: '#{ipa}'") unless File.exist?(ipa)

    api_key
    params = {
      ipa: ipa,
      # Processing takes minutes; internal testers get it when Apple is done.
      skip_waiting_for_build_processing: true,
      distribute_external: false
    }
    changelog = options[:changelog].to_s.strip
    params[:changelog] = changelog unless changelog.empty?
    upload_to_testflight(params)
  end

  # The App Store listing (#398): text in fastlane/metadata/, the age rating
  # in rating_config.json, screenshots from a release's store-screenshots.zip
  # (test/store_screenshots_test.dart). Edits whichever version App Store
  # Connect has open for editing; never uploads a build, never submits (#399).
  desc 'Upload the App Store listing. Options: screenshots (unzipped store-screenshots.zip), dry_run.'
  lane :upload_listing do |options|
    source = File.expand_path(options[:screenshots].to_s, File.expand_path('..', __dir__))
    devices = %w[iphone-6.9 ipad-13]
    locales = { 'en' => 'en-US', 'fr' => 'fr-FR' }
    unless devices.any? { |device| Dir.exist?(File.join(source, device)) }
      # overwrite_screenshots would otherwise delete the listing's current ones.
      UI.user_error!("No App Store screenshots in this release: '#{source}' has no #{devices.join(' or ')}")
    end

    target = File.expand_path('screenshots', __dir__)
    FileUtils.rm_rf(target)
    devices.product(locales.keys).each do |device, lang|
      Dir.glob(File.join(source, device, lang, '*.png')).sort.each do |png|
        # deliver sorts by name and tells devices apart by size; the prefix
        # keeps the two devices' "1_today.png" from colliding.
        dest = File.join(target, locales[lang], "#{device}_#{File.basename(png)}")
        FileUtils.mkdir_p(File.dirname(dest))
        FileUtils.cp(png, dest)
      end
    end
    copied = Dir.glob(File.join(target, '*', '*.png')).sort
    copied.each { |png| UI.message(png.delete_prefix("#{target}/")) }
    UI.success("#{copied.size} screenshots")
    next if options[:dry_run]

    api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!('Create a version in App Store Connect first: none is open for editing') unless version

    deliver(
      app_version: version.version_string,
      skip_binary_upload: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
      metadata_path: File.expand_path('metadata', __dir__),
      screenshots_path: target,
      overwrite_screenshots: true,
      app_rating_config_path: File.expand_path('rating_config.json', __dir__),
      # The rest of the review details is in metadata/review_information/.
      app_review_information: {
        phone_number: ENV.fetch('ASC_REVIEW_PHONE'),
        demo_user: ENV.fetch('ASC_DEMO_USER'),
        demo_password: ENV.fetch('ASC_DEMO_PASSWORD')
      }
    )
  end

  # Supabase's Apple provider takes, as its secret, a JWT signed with the
  # Sign in with Apple key. Apple caps it at 180 days, so this is rerun every
  # six months (README.md → Sign in with Apple). Nothing is written to disk.
  desc 'Print the Supabase Apple secret. Options: key (path to the .p8), key_id.'
  lane :apple_auth_secret do |options|
    require 'jwt'
    key = options[:key].to_s
    key_id = options[:key_id].to_s
    UI.user_error!("Key not found: '#{key}'") unless File.exist?(key)
    UI.user_error!('key_id is required: the Key ID shown beside the key') if key_id.empty?

    now = Time.now.to_i
    expires = now + 180 * 24 * 60 * 60
    claims = {
      iss: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
      iat: now,
      exp: expires,
      aud: 'https://appleid.apple.com',
      sub: 'app.loomia.signin' # The Services ID, not the App ID.
    }
    secret = JWT.encode(claims, OpenSSL::PKey::EC.new(File.read(key)), 'ES256', { kid: key_id })
    date = Time.at(expires).utc.strftime('%Y-%m-%d')

    # $stdout, not puts: fastlane prefixes puts with a timestamp, which would
    # end up in a copied secret.
    $stdout.puts secret
    UI.important("Expires #{date}. Then, for the weekly expiry check:")
    $stdout.puts "gh variable set APPLE_AUTH_SECRET_EXPIRES --repo paulthvt/loomia --body #{date}"
  end
end
