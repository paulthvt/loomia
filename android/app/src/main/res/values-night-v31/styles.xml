<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows the system splash: make it the first frame of
         LaunchSplash (lib/app/launch_splash.dart), the ring on brand ochre. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_ring</item>
        <!-- Android 16+ "expanded dark theme" darkens this splash (any non-dark
             colour) with no app opt-out; accepted, see #294. -->
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
